# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Project -> Connect -> "Connection pooling" ON (the host contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: the direct (unpooled) string. db:migrate and db:seed prefer it.
DATABASE_URL_UNPOOLED=

# The site's public address, no trailing slash. Email links and Paystack's
# callback URL are built from it (never from the request's Host header).
APP_URL=http://localhost:3020

# Optional: without it, every email is printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=Ọjà <onboarding@resend.dev>

# Paystack TEST keys (Dashboard -> Settings -> API Keys & Webhooks, test mode).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Protects /api/cron/expire-orders. A long random string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# An API key for npm run api:smoke (create one on /admin/api-keys with all four scopes).
SMOKE_API_KEY=

# Demo account passwords for npm run db:seed (8-128 characters each).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# DEMO MODE for portfolio visitors: one-click demo logins and a read-only demo API key.
# Leave false (or unset) for a real shop: the demo routes then answer 404.
DEMO_MODE=false
# The read-only demo API key printed on /docs (catalog:read only). Must look like
# oja_live_ followed by 43 base64url characters; db:seed stores only its hash.
#   node -e "console.log('oja_live_'+crypto.randomBytes(32).toString('base64url'))"
DEMO_API_KEY=
